# ==============================================================================
# BeTheBest - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these variables in the Project Settings -> Environment Variables.
# NEVER prefix secrets or database credentials with NEXT_PUBLIC_.
# ==============================================================================

# MongoDB Atlas Connection
# Standard MongoDB connection string with credentials, cluster address, and options.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Target Database Name
# Defaults to "bethebest" if omitted. Use "bethebest_preview" for preview deployments or "bethebest_prod" for production.
MONGODB_DB=bethebest

# Authentication & Session Security
# A cryptographically secure random secret (at least 32 characters) used to sign session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_secure_random_32_character_secret_string

# Application Base URL
# Local: http://localhost:3000
# Production: https://bethebest.yourdomain.com
NEXT_AUTH_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
